{
  "name": "newton-auth-cloudflare",
  "version": "0.1.1",
  "description": "Newton School authentication SDK for Cloudflare Workers (WebCrypto, zero dependencies)",
  "license": "UNLICENSED",
  "repository": "github:Newton-School/newton-auth-cloudflare",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/adapters/worker.d.ts",
      "import": "./dist/adapters/worker.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.1.0",
    "typescript": "~5.6.3",
    "vitest": "^1.6.0"
  }
}
